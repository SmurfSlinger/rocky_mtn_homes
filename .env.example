# Copy to .env.local on each environment (never commit .env.local).
# Production requirements: docs/PRODUCTION_ENV.md

# --- Database (required: use DATABASE_URL OR all DATABASE_* fields) ---
# DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/rocky_mtn_homes
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=rmh_user
# Quote passwords that contain # or other special characters (otherwise # starts a comment)
DATABASE_PASSWORD=
DATABASE_NAME=rocky_mtn_homes

# --- Staff auth (required in production) ---
# Min 32 random characters; never commit the real value
AUTH_SECRET=

# --- Listing photos from legacy PHP (optional) ---
# Absolute path to PHP public/ — read-only fallback for images/homes/* not yet in Next public/
# Omit after all listing files live under public/images/homes/
# LEGACY_PHP_PUBLIC_PATH=/var/www/rockymountainhomesales/software_dev/rocky_mtn_homes/public

# --- Contact form SMTP (required in production) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Rocky Mountain Contact Form
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile (required in production for /contact) ---
# Development: submissions work without keys (verification skipped; see server console)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
